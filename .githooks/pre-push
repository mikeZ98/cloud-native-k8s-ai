#!/usr/bin/env bash
# pre-push: audit every commit about to leave this machine.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"

fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # branch deletion
  if [[ "$remote_sha" == "$zero" ]]; then
    range=("$local_sha" --not --remotes)     # new branch: commits unknown to any remote
  else
    range=("$remote_sha..$local_sha")
  fi
  "$ROOT/scripts/audit-attribution.sh" "${range[@]}" || fail=1
done

exit "$fail"
