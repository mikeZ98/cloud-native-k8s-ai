#!/usr/bin/env bash
# pre-commit: enforce contributor identity, block cache/secret/state files,
# lint staged Python (ruff) and YAML (yamllint).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=_policy.sh
source "$ROOT/.githooks/_policy.sh"

fail=0

IFS=$'\t' read -r a_name a_email <<<"$(policy_parse_ident "$(git var GIT_AUTHOR_IDENT)")"
IFS=$'\t' read -r c_name c_email <<<"$(policy_parse_ident "$(git var GIT_COMMITTER_IDENT)")"
policy_check_identity "Author" "$a_name" "$a_email" || fail=1
policy_check_identity "Committer" "$c_name" "$c_email" || fail=1

# Staged paths that must never be committed (caches, secrets, tfstate, kubeconfigs).
forbidden_paths="$(git diff --cached --name-only --diff-filter=ACMR | policy_forbidden_paths)"
if [[ -n "$forbidden_paths" ]]; then
  policy_err "Refusing to commit cache, virtualenv, secret, Terraform state or kubeconfig files:"
  sed 's/^/    /' <<<"$forbidden_paths" >&2
  fail=1
fi

# The tools live in the uv venv under .cache/.
venv_bin="${UV_PROJECT_ENVIRONMENT:-$ROOT/.cache/venv}/bin"

# staged_files <pathspec>... → fills the global array `staged`.
# Plain read loop instead of mapfile: stays compatible with macOS /bin/bash 3.2.
staged_files() {
  staged=()
  while IFS= read -r f; do
    staged+=("$f")
  done < <(git diff --cached --name-only --diff-filter=ACMR -- "$@")
}

staged_files '*.py' '*.pyi'
if ((${#staged[@]} > 0)); then
  if [[ -x "$venv_bin/ruff" ]]; then
    "$venv_bin/ruff" check --quiet -- "${staged[@]}" || fail=1
    "$venv_bin/ruff" format --check --quiet -- "${staged[@]}" || fail=1
  else
    policy_err "ruff not found at $venv_bin/ruff — run 'uv sync' (with direnv loaded)."
    fail=1
  fi
fi

staged_files '*.yaml' '*.yml'
if ((${#staged[@]} > 0)); then
  if [[ -x "$venv_bin/yamllint" ]]; then
    # Ignore patterns (e.g. Helm templates) come from .yamllint.yaml.
    "$venv_bin/yamllint" --strict -- "${staged[@]}" || fail=1
  else
    policy_err "yamllint not found at $venv_bin/yamllint — run 'uv sync' (with direnv loaded)."
    fail=1
  fi
fi

exit "$fail"
