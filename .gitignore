# SSD-pinned caches, venv, temp, kube/helm/terraform homes, Colima (see .envrc)
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Terraform (commit .terraform.lock.hcl; never state or real variable values)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubernetes / Helm
kubeconfig*
*.kubeconfig
deploy/helm/*/charts/*.tgz

# Secrets & local overrides
.env
.env.*
!.env.example
.envrc.local
*.pem
*.key
*.p12
*.pfx

# OS / editors
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
