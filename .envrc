# shellcheck shell=bash
# cloud-native-k8s-ai — direnv environment.
#
# Pins every cache, virtualenv, temp dir, container socket and K8s/IaC tool
# home under ./.cache/ so nothing spills onto the internal macOS disk, and
# points kubectl/helm at an empty project-local kubeconfig so no command run
# from this repo can reach a live cluster by accident. Run `direnv allow` once.

# ---------------------------------------------------------------------------
# Project root & SSD pinning guard
# ---------------------------------------------------------------------------
PROJECT_ROOT="$(expand_path .)"
export PROJECT_ROOT
export SSD_VOLUME="/Volumes/KINGSTONE_SSD"

if [[ "$(uname -s)" == "Darwin" && "$PROJECT_ROOT" != "$SSD_VOLUME"/* ]]; then
  log_error "PROJECT_ROOT ($PROJECT_ROOT) is not on $SSD_VOLUME — caches would land on the internal disk."
fi

export CACHE_ROOT="$PROJECT_ROOT/.cache"

# ---------------------------------------------------------------------------
# XDG + temp
# ---------------------------------------------------------------------------
export XDG_CACHE_HOME="$CACHE_ROOT/xdg"
export XDG_STATE_HOME="$CACHE_ROOT/xdg-state"
export TMPDIR="$CACHE_ROOT/tmp"

# ---------------------------------------------------------------------------
# Python toolchain (uv-managed CPython 3.12, venv outside the source tree)
# ---------------------------------------------------------------------------
export UV_CACHE_DIR="$CACHE_ROOT/uv"
export UV_PYTHON_INSTALL_DIR="$CACHE_ROOT/uv-python"
export UV_PROJECT_ENVIRONMENT="$CACHE_ROOT/venv"
export UV_PYTHON="3.12"
export UV_PYTHON_PREFERENCE="only-managed"
export UV_LINK_MODE="copy"
export PIP_CACHE_DIR="$CACHE_ROOT/pip"
export PYTHONPYCACHEPREFIX="$CACHE_ROOT/pycache"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
PATH_add "$UV_PROJECT_ENVIRONMENT/bin"

# Linters / type checker / test runner
export RUFF_CACHE_DIR="$CACHE_ROOT/ruff"
export MYPY_CACHE_DIR="$CACHE_ROOT/mypy"
export COVERAGE_FILE="$CACHE_ROOT/coverage/.coverage"
export TRIVY_CACHE_DIR="$CACHE_ROOT/trivy"

# ---------------------------------------------------------------------------
# Kubernetes & IaC tooling (isolated from ~/.kube, ~/.helm, ~/.terraform.d)
# ---------------------------------------------------------------------------
export KUBECONFIG="$CACHE_ROOT/kube/config"
export KUBECACHEDIR="$CACHE_ROOT/kube/cache"
export HELM_CACHE_HOME="$CACHE_ROOT/helm/cache"
export HELM_CONFIG_HOME="$CACHE_ROOT/helm/config"
export HELM_DATA_HOME="$CACHE_ROOT/helm/data"
export TF_PLUGIN_CACHE_DIR="$CACHE_ROOT/terraform/plugins"
export CHECKPOINT_DISABLE="1" # no Terraform version-check phone-home

# ---------------------------------------------------------------------------
# Containers (Colima)
# ---------------------------------------------------------------------------
export COLIMA_HOME="$CACHE_ROOT/colima"
export LIMA_HOME="$COLIMA_HOME/_lima"
export DOCKER_HOST="unix://$COLIMA_HOME/default/docker.sock"
export DOCKER_CONFIG="$CACHE_ROOT/docker"

mkdir -p \
  "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$TMPDIR" \
  "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" "$PIP_CACHE_DIR" "$PYTHONPYCACHEPREFIX" \
  "$RUFF_CACHE_DIR" "$MYPY_CACHE_DIR" "$CACHE_ROOT/pytest" "$CACHE_ROOT/coverage" \
  "$TRIVY_CACHE_DIR" "$KUBECACHEDIR" "$HELM_CACHE_HOME" "$HELM_CONFIG_HOME" \
  "$HELM_DATA_HOME" "$TF_PLUGIN_CACHE_DIR" "$LIMA_HOME"
mkdir -p "$COLIMA_HOME" "$DOCKER_CONFIG"

# ---------------------------------------------------------------------------
# Git: hooks + sole-contributor identity (see CONTRIBUTING.md)
# ---------------------------------------------------------------------------
# Identity values mirror .githooks/_policy.sh (the enforcement source of truth).
if git -C "$PROJECT_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$PROJECT_ROOT" config core.hooksPath .githooks
  git -C "$PROJECT_ROOT" config user.name "mikeZ98"
  git -C "$PROJECT_ROOT" config user.email "145975972+mikeZ98@users.noreply.github.com"
  git -C "$PROJECT_ROOT" config user.useConfigOnly true
fi

source_env_if_exists .envrc.local
